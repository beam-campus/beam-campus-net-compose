# BEAM Campus — production deploy env. Copy to .env, fill in. NEVER commit .env.

# Required — generate with: openssl rand -base64 48  (or mix phx.gen.secret)
SECRET_KEY_BASE=

# Image tag to run (ghcr.io: ghcr.io/beam-campus/beam-campus-net)
SITE_VERSION=latest

# Domain + TLS (Caddy auto-provisions Let's Encrypt)
PHX_HOST=beam-campus.net
SITE_ADDRESS=beam-campus.net, www.beam-campus.net
ACME_EMAIL=raf.lefever@erlef.org

# Mailgun (optional until the contact form ships). EU region.
BEAM_CAMPUS_MAILGUN_API_KEY=
BEAM_CAMPUS_MAILGUN_DOMAIN=mg.beam-campus.net
BEAM_CAMPUS_MAILGUN_BASE_URL=https://api.eu.mailgun.net
BEAM_CAMPUS_CONTACT_EMAIL=raf.lefever@erlef.org

# Mesh spectators. Both default to a station in the compose file, so leaving
# these unset still shows live pages; set them to point at a different station.
# Reading uses PUBLIC realms only, which the apps default to, and never the
# fleet realm: a public web container must not hold the tag that routes
# sentinel sightings and warden facts.
BEAM_CAMPUS_RUMBLE_SEEDS=https://station-de-frankfurt.macula.io:4433
BEAM_CAMPUS_BIOTOPE_SEEDS=https://station-de-frankfurt.macula.io:4433

# ── net.beam-campus realm (DRAFT — see docker-compose.yml's own note on
# this box's memory budget before enabling) ────────────────────────────────

# Hanko's own dedicated postgres. Generate with: openssl rand -base64 24
HANKO_DB_PASSWORD=

# realm-identity (macula-realm) — generate with: openssl rand -base64 48
REALM_IDENTITY_SECRET_KEY_BASE=
# This realm's own Ed25519 signing key, base64, 32 raw bytes — generate
# with: openssl rand -base64 32. Deliberately NOT io.macula's or
# macula-portal's key.
REALM_IDENTITY_UCAN_PRIVATE_KEY=
# Gates realm-identity's admin RPCs (initiate_realm/admit_realm_member/
# revoke_membership/rotate_key) — generate with: openssl rand -base64 32
REALM_IDENTITY_ADMIN_TOKEN=
# Image tag to run (ghcr.io: ghcr.io/macula-io/macula-realm)
REALM_IDENTITY_VERSION=main
# Station seeds realm-identity dials to join the mesh (comma-separated).
# Unset means it never joins the mesh at all — no procedures advertised.
MACULA_RELAYS=https://station-de-frankfurt.macula.io:4433
