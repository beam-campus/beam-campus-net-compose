# BEAM Campus — Caddy reverse proxy
#
# Caddy terminates TLS and does automatic HTTPS: for a real domain it
# provisions and renews Let's Encrypt certificates on its own (needs ports
# 80 + 443 reachable and an ACME email); for `localhost` in dev it falls back
# to Caddy's internal self-signed CA.
#
# MODE: LIVE — proxies to the app. To shield behind a placeholder again, swap
# the `reverse_proxy` line for the holding block (kept in git history / the
# caddy/holding/ files remain) and add back `X-Robots-Tag "noindex, nofollow"`.

{
	email {$ACME_EMAIL:raf.lefever@erlef.org}
	# acme_ca https://acme-staging-v02.api.letsencrypt.org/directory
}

{$SITE_ADDRESS:localhost} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
	}

	# Long-cache the digested, content-addressed assets.
	@static path /assets/* /fonts/* /images/* /favicon.svg /favicon.ico /robots.txt
	header @static Cache-Control "public, max-age=31536000, immutable"

	reverse_proxy {$SITE_UPSTREAM:site:4000}
}
